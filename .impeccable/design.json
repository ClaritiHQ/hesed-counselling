  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Primary session-request action.",
      "html": "<button class=\"ds-control ds-primary\">Book a session</button>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;padding:15px 25px;border:1px solid transparent;border-radius:8px;font:500 .86rem/1.5 var(--sans,Geist,Arial,sans-serif);text-decoration:none;transition:background .2s,transform .2s,box-shadow .2s;background:var(--brand-plum,#5a375b);color:#fbfafb}.ds-primary:hover:not(:disabled){background:#482b49;color:#fff;transform:translateY(-2px);box-shadow:0 5px 18px #4b304c18}.ds-primary:disabled{opacity:.5;cursor:not-allowed}.ds-control:focus-visible{outline:3px solid var(--brand-plum,#5a375b);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-control{transition:none!important;transform:none!important}}"
    },
