  "narrative": {
    "northStar": "The Welcoming Room",
    "overview": "The Welcoming Room is warm, calm and professional: generous space, gentle curves and reassuring language make the interface feel approachable. Deep Plum anchors actions and contact information; pale surfaces keep longer sections quiet.\n\nComponents are gentle and clear. Depth comes mainly from tonal layers and fine borders, with ambient shadows reserved for floating elements and hover states. This records the existing implementation, not a redesign or an accessibility certification.",
    "keyCharacteristics": [
      "Logo-led plum identity with Geist typography.",
      "Spacious sections and rounded, lightly bordered components.",
      "Arched image and brand panels as recurring signatures.",
      "Subtle layers rather than heavy elevation."
    ],
    "rules": [
      {
        "name": "The Logo Leads Rule",
        "body": "Use plum for the primary identity and actions; do not reintroduce a green-led theme.",
        "section": "colors"
      },
      {
        "name": "The One Family Rule",
        "body": "Use Geist across display, body and controls, with Arial and sans-serif fallbacks.",
        "section": "typography"
      },
      {
        "name": "The Subtle Layers Rule",
        "body": "Keep cards flat at rest; reserve ambient shadows for floating surfaces and hover feedback.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the supplied logo, plum identity and Geist typography.",
      "Do retain clear keyboard focus and reduced-motion behaviour.",
      "Do keep contact information readable and able to wrap on narrow screens."
    ],
    "donts": [
      "Don't restore green as the main theme colour.",
      "Don't present placeholder photography as the actual therapist or office.",
      "Don't treat recorded small text sizes as proof of accessibility compliance."
    ]
  }
