      "description": "Secondary action on a light surface.",
      "html": "<button class=\"ds-control ds-outline\">What to expect</button>",
      "css": ".ds-outline{display:inline-flex;align-items:center;justify-content:center;padding:15px 25px;border:1px solid transparent;border-radius:8px;font:500 .86rem/1.5 var(--sans,Geist,Arial,sans-serif);text-decoration:none;transition:background .2s,transform .2s,box-shadow .2s;background:transparent;color:var(--ink,#352d36);border-color:#af9fb0}.ds-outline:hover:not(:disabled){background:#eee9ef;transform:translateY(-2px)}.ds-outline:disabled{opacity:.5;cursor:not-allowed}.ds-control:focus-visible{outline:3px solid var(--brand-plum,#5a375b);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-control{transition:none!important;transform:none!important}}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "field",
      "description": "Labelled practical booking detail.",
      "html": "<label class=\"ds-field\">Your name<input class=\"ds-control ds-input\" autocomplete=\"name\" placeholder=\"Your name\"></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:8px;font:500 .8rem var(--sans,Geist,Arial,sans-serif);color:var(--ink,#352d36)}.ds-input{padding:12px 13px;border:1px solid #d4c4d5;border-radius:7px;background:#fdfdfd;color:var(--ink,#352d36);font:.86rem/1.6 var(--sans,Geist,Arial,sans-serif);min-width:0}.ds-input::placeholder{color:#735f74;opacity:1}.ds-input:focus{outline:2px solid var(--brand-plum,#5a375b);outline-offset:2px}.ds-control:focus-visible{outline:3px solid var(--brand-plum,#5a375b);outline-offset:4px}"
    },
    {
      "name": "Service Card",
      "kind": "card",
      "refersTo": "service-card",
      "description": "Quiet service introduction with linked action.",
      "html": "<a class=\"ds-control ds-card\" href=\"/services/#individual\"><span class=\"ds-number\">01</span><h3 class=\"ds-title\">Individual therapy</h3><p class=\"ds-copy\">A little space, just for you.</p><span class=\"ds-link\">Explore support →</span></a>",
      "css": ".ds-card{display:flex;flex-direction:column;min-height:257px;max-width:260px;padding:26px 22px 24px;background:var(--paper,#fff);color:var(--ink,#352d36);border:1px solid #e1d5e1;border-radius:12px;text-decoration:none;font-family:var(--sans,Geist,Arial,sans-serif);transition:transform .2s,background .2s}.ds-card:hover{background:#efe7ef;transform:translateY(-5px)}.ds-number{font-size:.62rem;color:#715772;margin-bottom:28px}.ds-title{font-size:1.3rem;font-weight:500;letter-spacing:-.04em;margin:0 0 12px}.ds-copy{font-size:.76rem;line-height:1.7;color:var(--muted,#6b606d);flex:1;margin:0 0 28px}.ds-link{font-size:.7rem}.ds-control:focus-visible{outline:3px solid var(--brand-plum,#5a375b);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-control{transition:none!important;transform:none!important}}"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "description": "Understated desktop links with active-route marker.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Example navigation\"><a class=\"ds-control ds-nav-link\" href=\"/about/\" aria-current=\"page\">About</a><a class=\"ds-control ds-nav-link\" href=\"/services/\">How I can help</a><a class=\"ds-control ds-nav-link\" href=\"/contact/\">Contact</a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;flex-wrap:wrap;gap:29px;padding:12px;font-family:var(--sans,Geist,Arial,sans-serif)}.ds-nav-link{position:relative;font-size:.78rem;color:#584e58;text-decoration:none}.ds-nav-link:hover{color:var(--brand-plum,#5a375b)}.ds-nav-link[aria-current=page]:after{content:'';position:absolute;bottom:-9px;left:0;width:100%;height:1px;background:#6a476b}.ds-control:focus-visible{outline:3px solid var(--brand-plum,#5a375b);outline-offset:4px}"
